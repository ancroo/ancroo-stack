# ancroo-stack — Environment Configuration Example
#
# ⚠️  DO NOT COPY THIS FILE!
# This is a REFERENCE showing what variables install.sh creates.
# The actual .env file is auto-generated by install.sh.
#
# Purpose: Documentation of available configuration variables
# Location: .env (auto-generated, not in Git)

# ============================================================
# SYSTEM CONFIGURATION (set by install.sh)
# ============================================================

# Timezone (e.g., Europe/Berlin, America/New_York, Asia/Tokyo)
TZ="Europe/Berlin"

# GPU Mode: cpu | nvidia | rocm
GPU_MODE="cpu"

# STT Engine: speaches | whisper-rocm
STT_ENGINE="speaches"

# Admin email (used for n8n, BookStack, SSL certificates)
ANCROO_ADMIN_EMAIL="admin@ancroo.local"

# Docker Compose Files (managed by install.sh and stack.sh)
# Built from: base + ports + gpu overlay + stt engine + external projects
COMPOSE_FILE="docker-compose.yml:docker-compose.ports.yml:compose.speaches.yml"

# ============================================================
# DATABASE — PostgreSQL (auto-generated by install.sh)
# ============================================================

POSTGRES_USER="ancroo"
POSTGRES_PASSWORD="<auto-generated-32-char-random-string>"
POSTGRES_DB="ancroo"
DATABASE_URL="postgresql://ancroo:<password>@postgres:5432/ancroo"

# ============================================================
# OPEN WEBUI (auto-generated by install.sh)
# ============================================================

# Secret key for session management (base64, 48 bytes)
WEBUI_SECRET_KEY="<auto-generated-base64-string>"

# ============================================================
# HOMEPAGE DASHBOARD (auto-detected by install.sh)
# ============================================================

# User/Group IDs for file permissions
PUID="1000"
DOCKER_GID="999"

# Host IP for access URLs (auto-detected from hostname -I)
HOST_IP="192.168.1.100"

# ============================================================
# n8n (Workflow Automation)
# ============================================================

N8N_PORT="5678"
N8N_DB="ancroo_n8n"
N8N_ENCRYPTION_KEY="<auto-generated-hex-16>"
# Provisioned automatically by install.sh:
# ANCROO_N8N_API_KEY="<auto-provisioned-api-key>"
# N8N_ADMIN_EMAIL="admin@ancroo.local"
# N8N_ADMIN_PASSWORD="<auto-generated>"

# ============================================================
# BOOKSTACK (Wiki / Knowledge Base)
# ============================================================

BOOKSTACK_PORT="8875"
BOOKSTACK_APP_KEY="<auto-generated-base64>"
BOOKSTACK_APP_URL="http://192.168.1.100:8875"
BOOKSTACK_DB_PASSWORD="<auto-generated>"
BOOKSTACK_DB_ROOT_PASSWORD="<auto-generated>"
BOOKSTACK_ADMIN_EMAIL="admin@ancroo.local"
BOOKSTACK_ADMIN_PASSWORD="<auto-generated>"

# ============================================================
# ADMINER (Database UI)
# ============================================================

ADMINER_PORT="8081"

# ============================================================
# STT (Speech-to-Text)
# ============================================================

SPEACHES_PORT="8100"
WHISPER_ROCM_PORT="8002"

# ============================================================
# GPU-SPECIFIC VARIABLES (auto-detected for ROCm)
# ============================================================

# Always written when GPU_MODE=rocm (empty defaults suppress Docker Compose warnings):
OLLAMA_IMAGE_TAG=""                  # "rocm" (default) or specific version for RDNA 4
HIP_VISIBLE_DEVICES=""
HSA_OVERRIDE_GFX_VERSION=""          # Set manually if GPU not auto-detected
OLLAMA_FLASH_ATTENTION=""

# How long Ollama keeps a model resident in VRAM after the last request.
# Higher values = fewer cold loads but the model holds VRAM. Format: "30m", "2h", "24h", "0" to disable.
OLLAMA_KEEP_ALIVE=""                 # default: 30m

# ============================================================
# COMPOSE_FILE EXAMPLES
# ============================================================
#
# CPU + Speaches (minimal):
# COMPOSE_FILE="docker-compose.yml:docker-compose.ports.yml:compose.speaches.yml"
#
# NVIDIA + Speaches:
# COMPOSE_FILE="docker-compose.yml:docker-compose.ports.yml:compose.gpu-nvidia.yml:compose.speaches.yml"
#
# ROCm + Whisper-ROCm:
# COMPOSE_FILE="docker-compose.yml:docker-compose.ports.yml:compose.gpu-rocm.yml:compose.whisper-rocm.yml"
#
# ROCm + Whisper-ROCm + Backend + Runner:
# COMPOSE_FILE="docker-compose.yml:docker-compose.ports.yml:compose.gpu-rocm.yml:compose.whisper-rocm.yml:../ancroo-backend/module/compose.yml:../ancroo-backend/module/compose.ports.yml:../ancroo-runner/module/compose.yml:../ancroo-runner/module/compose.ports.yml"

# ============================================================
# NOTES
# ============================================================
#
# 1. DO NOT create .env manually - run install.sh instead
# 2. DO NOT commit .env to Git (already in .gitignore)
# 3. Passwords are auto-generated for security
# 4. Use stack.sh to manage GPU/STT switching
# 5. Backup .env securely - it contains all credentials
